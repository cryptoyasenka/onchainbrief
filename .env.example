# Copy to .env (gitignored) and fill. Never commit real values.

# ─── Ace Data Cloud — credit-billed access (dev / cost measurement) ─────────
# Account-wide token from platform.acedata.cloud dashboard. Used for chat
# and serp when the x402 wallet is not set, and as the last-resort fallback
# for the image service if no per-app image token is provided.
ACE_API_TOKEN=

# Per-Application token for the image service (NanoBanana/Flux channel).
# The account-wide token has no image channel and returns "No available
# channel for model ... under group default". ACE_API_TOKEN_NANO is the
# primary name; ACE_API_TOKEN_FLUX is a legacy fallback preserved so
# existing .env files keep working after the nano-banana switch.
ACE_API_TOKEN_NANO=
# ACE_API_TOKEN_FLUX=

# ─── x402 on-chain payment path (production) ────────────────────────────────
# EVM private key holding USDC on Base mainnet for x402 settlement.
# Facilitator covers gas; wallet only needs a few USDC. Dedicated throwaway
# key — NEVER reuse a key that holds anything else.
ACE_X402_PRIVATE_KEY=

# Optional: Base RPC URL for scripts/fetch_basescan_tx.py (the e2e tx-hash
# reproducer). Defaults to https://mainnet.base.org (public node).
# BASE_RPC_URL=https://mainnet.base.org

# x402 signing-policy guardrails. A signed EIP-3009 authorization lets the
# holder pull `value` USDC from the wallet, so the client validates every 402
# challenge against these BEFORE signing. Defaults are safe for ACE's three
# services (largest real call ~0.095 USDC). Raise the cap only if a costlier
# service is added; pin payTo/verifyingContract to harden further.
# X402_MAX_AMOUNT_REQUIRED=1000000          # atomic USDC (6 decimals) = 1 USDC
# X402_EXPECTED_CHAIN_ID=8453               # Base mainnet
# X402_EXPECTED_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  # USDC on Base
# Production hardening (recommended for a live, wallet-bearing deploy): pin the
# recipient to the ACE facilitator and the EIP-712 domain to the USDC contract.
# X402_ALLOWED_PAY_TO=0x4F0E2D3477a1B94CF33d16E442CEe4733dadCeE7   # ACE facilitator
# X402_EXPECTED_VERIFYING_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  # USDC on Base

# ─── Solana event watcher (mainnet) ─────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# RPC endpoints the browser "Verify On-Chain" button hits. These are the single
# source of truth for both the generated feed JS and the server CSP connect-src,
# so a verify fetch is never blocked by a host the page isn't allowed to call.
# Defaults are keyless public nodes; mainnet uses publicnode (api.mainnet-beta
# is rate-limited and lacks permissive CORS for browser fetches).
# DEVNET_RPC_URL=https://api.devnet.solana.com
# MAINNET_RPC_URL=https://solana-rpc.publicnode.com

# REQUIRED for live runs (`python -m onchainbrief.run`). Comma-separated
# Solana program IDs that the logsSubscribe watcher should follow. Without
# this, run.py hard-exits at startup. Examples: Jupiter v6, Raydium, Orca.
WATCH_PROGRAM_IDS=

# ─── Agent watch settings (what is worth a brief) ───────────────────────────
# These tune WHAT the agent spends on, so whoever self-hosts can point it at
# their own wallet (keys above) and set their own editorial bar without code.
# A value-moving swap/transfer must clear this dollar size to be briefed
# (default 10000 = $10k floor for "meaningful volume"; raise for a whale-only feed):
# MIN_BRIEF_USD=10000
# The three event types below are briefed regardless of dollar size because
# they are notable by nature. Set to false to stop watching that type.
# WATCH_DEPLOYS=true       # new program deploys / upgrades
# WATCH_GOVERNANCE=true    # SPL-Governance proposal / vote actions
# WATCH_SECURITY=true      # setAuthority / freeze / thaw / revoke
# Live overrides written by the local operator panel land here (env is the
# default, this JSON file wins when present so changes apply without a restart):
# WATCH_CONFIG_PATH=.state/watch_config.json
# Shared secret that unlocks the local operator panel at /operator (a small web
# form to retune the bar/switches above without redeploying). LEAVE EMPTY to
# keep the panel fully disabled — the server binds 0.0.0.0 on Railway, so the
# write endpoint must never be exposed unless you deliberately set a token.
# OPERATOR_TOKEN=

# ─── Per-brief on-chain attestation (Memo program) ──────────────────────────
# Path to the dedicated Solana keypair used ONLY for the attest tx. Keep it
# OUTSIDE the repo (absolute path or gitignored dir); never commit it.
SOLANA_KEYPAIR_PATH=/path/to/solana-keypair.json

# Optional explicit recipient for public on-demand paid brief requests. If this
# is empty, the app derives the recipient from SOLANA_KEYPAIR_PATH when that
# keypair is available. If neither exists, /api/request-brief is disabled and
# the static feed hides the paid request form.
AGENT_PAYMENT_WALLET=

# Cluster for the per-brief Memo attestation tx. devnet (default) is free
# via airdrop and proves the code path; mainnet-beta is the real submission
# run (sub-cent per memo). ATTEST_RPC_URL is an optional override for a
# non-public RPC (e.g. Helius).
ATTEST_CLUSTER=devnet
# ATTEST_RPC_URL=

# ─── SAP on-chain agent registration (sap/ TypeScript shim) ─────────────────
# One of:
#   SAP_KEYPAIR_PATH — Solana CLI JSON byte-array file (recommended; can be
#                      the same dedicated key as SOLANA_KEYPAIR_PATH above)
#   SAP_PRIVATE_KEY  — base58 secret key (sponsor-compatible env name)
# The sap/ script never generates a key. Set only one of these.
SAP_KEYPAIR_PATH=/path/to/solana-keypair.json
# SAP_PRIVATE_KEY=

# SAP discovery trust pins (discovery.py). The capability registry is
# permissionless, so a squatter could register first under our capability id.
# SAP_ALLOWED_API_BASES now DEFAULTS to the ACE base even when unset, so a paid
# call can never be redirected to a foreign host; on mismatch discovery falls
# back to the static ACE_API_BASE. For a live deploy also pin the exact agent
# PDA so endpoint resolution only ever trusts our own on-chain registration:
# SAP_EXPECTED_AGENT_PDA=DsTZa5xY4sF8y3JFdE53B8T9xEsYtvntEUggm6FwMgVi
# SAP_ALLOWED_API_BASES=https://api.acedata.cloud

# ─── Optional runtime tuning ────────────────────────────────────────────────
# Where the agent writes briefs and renders the static feed. Defaults are
# fine for local dev; Railway deploy uses the same defaults.
# BRIEFS_DIR=./briefs
# SITE_HTML=./site/index.html

# Local LLM used by filter.py for the "brief-worthy?" triage. Free, optional
# — without it the agent falls back to a deterministic heuristic. Any
# OpenAI-compatible endpoint works (Ollama, vLLM, LM Studio, NVIDIA NIM).
# LOCAL_LLM_BASE=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1:8b
# LOCAL_LLM_KEY=

# Daily spend gate. State file is gitignored. Default = 1 brief/day (very
# conservative — bump for production). Raise gradually as you trust the
# pipeline; each brief = three x402 settlements on Base.
# THROTTLE_STATE=.state/throttle.json
# DAILY_BRIEF_CAP=1

# On-demand "Request a Brief" clusters. The payment and the analyzed tx live on
# different clusters, so they have separate RPCs. PAYMENT_RPC_URL is where the
# frontend signs AND the server verifies the payment (must match — default
# follows PAYMENT_CLUSTER). TARGET_TX_RPC_URL is where the analyzed transaction
# is fetched (default mainnet, matching the watcher). REQUEST_BRIEF_LAMPORTS is
# the single price source for the UI label, JS amount, and server minimum.
# PAYMENT_CLUSTER=devnet
# PAYMENT_RPC_URL=                              # default: devnet/mainnet per PAYMENT_CLUSTER
# TARGET_TX_RPC_URL=                            # default: MAINNET_RPC_URL

# Public on-demand request hardening. Defaults are intentionally conservative.
# PAYMENTS_LEDGER_PATH=.state/payments.json
# MAX_REQUEST_BYTES=4096
# REQUEST_BRIEF_LAMPORTS=1000000
# PAYMENT_MAX_AGE_S=1800
# ONDEMAND_QUEUE_MAX=10
# ONDEMAND_WORKERS=1
# REQUEST_RATE_LIMIT_WINDOW_S=60
# REQUEST_RATE_LIMIT_PER_IP=5
# REQUEST_GLOBAL_RATE_LIMIT=20
# ALLOWED_ORIGIN=https://your-production-domain.example
